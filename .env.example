# ─────────────────────────────────────────────────────────────────
# LITTLE HOTELIER → LIMPATEX  — Variables de entorno
# Copia este archivo como ".env" y rellena tus datos reales
# ─────────────────────────────────────────────────────────────────

# Credenciales de Little Hotelier
LH_EMAIL=tu_correo@ejemplo.com
LH_PASSWORD=tu_password_aqui

# ID de tu propiedad en Little Hotelier
# (lo encuentras en la URL cuando navegas por tu cuenta, ej: /properties/12345)
LH_PROPERTY_ID=12345

# Tu app de gestión de limpiezas
APP_URL=https://gestionlimpatex.vercel.app
APP_API_KEY=
