# ─────────────────────────────────────────────────────────────────
# LITTLE HOTELIER → LIMPATEX — Variables de entorno
# Copia este archivo como .env y rellena SOLO en local/Render.
# No subas .env ni lh_cookies.json al repositorio.
# ─────────────────────────────────────────────────────────────────

# Little Hotelier / SiteMinder
LH_EMAIL=tu_correo_little_hotelier@example.com
LH_PASSWORD=<tu_password_little_hotelier>
LH_SESSION_TOKEN=
LH_COOKIES_JSON=
LH_PROPERTY_UUID=8d0c221e-3a40-4eda-8c15-deb2450cd307
LH_REGION=emea
LH_HEADLESS=1
DISABLE_AUTO_LOGIN=0

# Rutas persistentes. En Render se montan bajo /data.
LH_COOKIES_PATH=lh_cookies.json
LH_BROWSER_PROFILE_DIR=
LH_STATE_PATH=lh_sync_state.json
LH_DEBUG_DIR=debug

# Limpatex
APP_URL=https://gestionlimpatex.vercel.app
APP_API_KEY=<tu_api_key_interna>
DAYS_BACK=7
DAYS_AHEAD=30

# Scheduler interno del worker Render
RUN_TIMEZONE=Europe/Madrid
RUN_AT_HOURS=09:00,14:00,20:00
RUN_ON_START=0
SCHEDULER_POLL_SECONDS=60

# Alertas por email — opción A: Resend
ALERT_EMAIL_TO=dgomezlimpatex@gmail.com
ALERT_EMAIL_FROM=alertas@limpatex.com
RESEND_API_KEY=

# Alertas por email — opción B: SMTP si no usas Resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
ALERT_COOLDOWN_MINUTES=180
ALERT_AFTER_HOURS_WITHOUT_SUCCESS=12
ALERT_ON_ZERO_RESERVATIONS=0

# Supabase opcional para backup de cookies/estado
SUPABASE_URL=https://qyipyygojlfhdghnraus.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATE_TABLE=private_lh_integration_state
LH_SECRET_STORE_ENABLED=0

# Opcional: automatización local antigua para actualizar variables de Render
RENDER_API_KEY=
RENDER_SERVICE_ID=
RENDER_TRIGGER_DEPLOY=1
